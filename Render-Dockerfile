FROM node:22-bookworm-slim AS frontend
WORKDIR /workspace/frontend
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
ARG VITE_WEATHER_API_URL=https://ariel-sdd-weather-microservice.onrender.com/api/weather
ARG VITE_AUTH_API_URL=https://ariel-sdd-weather-microservice.onrender.com
ENV VITE_WEATHER_API_URL=$VITE_WEATHER_API_URL
ENV VITE_AUTH_API_URL=$VITE_AUTH_API_URL
RUN npm test && npm run build

FROM nginx:stable-alpine
COPY --from=frontend /workspace/frontend/dist/ /usr/share/nginx/html/
COPY frontend/deploy/original-nginx.conf.template /etc/nginx/templates/default.conf.template
ENV PORT=8080
EXPOSE 8080
