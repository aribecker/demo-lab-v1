FROM node:22-alpine AS frontend
WORKDIR /app
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
ENV VITE_CHAT_API_URL=/
RUN npm test && npm run build

FROM maven:3.9.9-eclipse-temurin-17 AS build
WORKDIR /workspace
COPY weather-service/pom.xml ./pom.xml
COPY weather-service/src ./src
COPY --from=frontend /app/dist ./src/main/resources/static
RUN mvn --batch-mode --no-transfer-progress package

FROM eclipse-temurin:17-jre-jammy
WORKDIR /app
COPY --from=build /workspace/target/weather-service-2.0.0.jar ./app.jar
USER 10001:10001
ENV PORT=8080
EXPOSE 8080
ENTRYPOINT ["java", "-XX:MaxRAMPercentage=65", "-jar", "app.jar"]
