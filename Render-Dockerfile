FROM maven:3.9.9-eclipse-temurin-17 AS build
WORKDIR /build
ADD source-snapshot.tar.gz /build/
WORKDIR /build/java-backend
RUN mvn -B -DskipTests package
FROM eclipse-temurin:17-jre
WORKDIR /app
COPY --from=build /build/java-backend/target/weather-java-0.3.0.jar /app/app.jar
ENV PORT=8080
EXPOSE 8080
CMD ["java", "-XX:MaxRAMPercentage=65", "-jar", "/app/app.jar"]
