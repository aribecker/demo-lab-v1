# Build tests use real PostgreSQL 17 in a disposable build-stage cluster.
FROM maven:3.9.9-eclipse-temurin-17 AS toolchain
FROM postgres:17-bookworm AS build
COPY --from=toolchain /opt/java/openjdk /opt/java/openjdk
COPY --from=toolchain /usr/share/maven /usr/share/maven
ENV JAVA_HOME=/opt/java/openjdk
ENV PATH=/opt/java/openjdk/bin:/usr/share/maven/bin:$PATH
WORKDIR /workspace
COPY people-service/pom.xml ./pom.xml
COPY people-service/src ./src
RUN install -d -o postgres -g postgres /tmp/people-test-pg && \
    gosu postgres initdb -D /tmp/people-test-pg -A trust --no-locale -E UTF8 && \
    gosu postgres pg_ctl -D /tmp/people-test-pg -o "-h 127.0.0.1 -p 5432" -w start && \
    PEOPLE_TEST_DB_URL=jdbc:postgresql://127.0.0.1:5432/postgres PEOPLE_TEST_DB_USER=postgres \
      mvn --batch-mode --no-transfer-progress package && \
    gosu postgres pg_ctl -D /tmp/people-test-pg -m fast -w stop
FROM eclipse-temurin:17-jre-jammy
WORKDIR /app
COPY --from=build /workspace/target/people-service-1.0.0.jar ./app.jar
USER 10001:10001
ENV PORT=8080
EXPOSE 8080
ENTRYPOINT ["java", "-XX:MaxRAMPercentage=65", "-jar", "app.jar"]
