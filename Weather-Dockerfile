FROM maven:3.9.9-eclipse-temurin-17 AS build
WORKDIR /build
COPY weather-service/pom.xml ./pom.xml
COPY weather-service/src ./src
RUN mvn -B package
FROM eclipse-temurin:17-jre
WORKDIR /app
COPY --from=build /build/target/weather-service-0.0.8.jar /app/app.jar
ENV PORT=8080
EXPOSE 8080
CMD ["java", "-XX:MaxRAMPercentage=65", "-jar", "/app/app.jar"]
