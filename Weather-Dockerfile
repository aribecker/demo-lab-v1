# Stage 1: Maven compiles the new source, runs its tests and packages the executable JAR.
FROM maven:3.9.9-eclipse-temurin-17 AS toolchain
FROM postgres:17-bookworm AS build
COPY --from=toolchain /opt/java/openjdk /opt/java/openjdk
COPY --from=toolchain /usr/share/maven /usr/share/maven
ENV JAVA_HOME=/opt/java/openjdk
ENV PATH=/opt/java/openjdk/bin:/usr/share/maven/bin:$PATH
WORKDIR /workspace
COPY weather-service/pom.xml ./pom.xml
COPY weather-service/src ./src
RUN install -d -o postgres -g postgres /tmp/simulation-test-pg && \
    gosu postgres initdb -D /tmp/simulation-test-pg -A trust --no-locale -E UTF8 && \
    gosu postgres pg_ctl -D /tmp/simulation-test-pg -o "-h 127.0.0.1 -p 5432" -w start && \
    SIMULATION_TEST_DATABASE_URL='jdbc:postgresql://127.0.0.1:5432/postgres?user=postgres' \
      mvn --batch-mode --no-transfer-progress package && \
    gosu postgres pg_ctl -D /tmp/simulation-test-pg -m fast -w stop

# Stage 2: only the Java runtime and the JAR become the running service.
FROM postgres:17-bookworm AS runtime
COPY --from=toolchain /opt/java/openjdk /opt/java/openjdk
ENV JAVA_HOME=/opt/java/openjdk
ENV PATH=/opt/java/openjdk/bin:$PATH
WORKDIR /app
COPY --from=build /workspace/target/weather-service-2.0.0.jar ./app.jar
USER 10001:10001
ENV PORT=8080
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "app.jar"]


